# Public front of the Sellbird dashboard for Dokploy (sellbird.dropia.uy).
#
# The dashboard binds 127.0.0.1:5555 and refuses any Host or Origin that is not
# loopback. Traefik (Dokploy) sends the public request here, on :8080; this
# proxy only lets through requests that came through Cloudflare (where
# Cloudflare Access asks who you are) and hands them to the dashboard as local.
# The dashboard's own unlock token is still required on every API call.
{
	admin off
	auto_https off
	servers {
		# Traefik runs on the Docker network: trust its X-Forwarded-For, which
		# carries the address of the Cloudflare edge that reached it.
		trusted_proxies static private_ranges
		client_ip_headers X-Forwarded-For
		# The right-most untrusted address: a client cannot pose as Cloudflare by
		# sending its own X-Forwarded-For, whether Traefik appends or replaces it.
		trusted_proxies_strict
	}
}

:8080 {
	# route keeps the order written here: Caddy would otherwise run handle before respond.
	route {
		@outside_cloudflare not client_ip 173.245.48.0/20 103.21.244.0/22 103.22.200.0/22 103.31.4.0/22 141.101.64.0/18 108.162.192.0/18 190.93.240.0/20 188.114.96.0/20 197.234.240.0/22 198.41.128.0/17 162.158.0.0/15 104.16.0.0/13 104.24.0.0/14 172.64.0.0/13 131.0.72.0/22 2400:cb00::/32 2606:4700::/32 2803:f800::/32 2405:b500::/32 2405:8100::/32 2a06:98c0::/29 2c0f:f248::/32
		respond @outside_cloudflare "Forbidden" 403

		# Cloudflare Access puts this header on every request it lets through.
		@no_access_identity not header Cf-Access-Jwt-Assertion *
		respond @no_access_identity "Forbidden" 403

		# Only the public origin is translated to the local one: any other Origin
		# reaches the dashboard as it came, and its cross-origin check refuses it.
		@public_origin header Origin {$SELLBIRD_PUBLIC_ORIGIN:https://sellbird.dropia.uy}
		handle @public_origin {
			reverse_proxy 127.0.0.1:5555 {
				header_up Host 127.0.0.1:5555
				header_up Origin http://127.0.0.1:5555
				header_up -Cf-Access-Jwt-Assertion
				header_up -Cookie
			}
		}
		handle {
			reverse_proxy 127.0.0.1:5555 {
				header_up Host 127.0.0.1:5555
				header_up -Cf-Access-Jwt-Assertion
				header_up -Cookie
			}
		}
	}
}
